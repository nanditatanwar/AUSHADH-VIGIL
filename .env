# Environment variables for Aushadh Vigil backend

# Database connection (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Secret key for JWT signing
SECRET_KEY=change_this_secret_key_to_a_long_random_string

# Algorithm for JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# PubMed API settings (optional)
PUBMED_API_KEY=  # NCBI API key if you have one (optional)
PUBMED_TOOL=aushadh_vigil
PUBMED_EMAIL=your.email@example.com

# PDF generation (if needed)
# No extra vars needed for ReportLab

# Environment
ENVIRONMENT=debug
DEBUG=True